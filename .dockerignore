# The build needs pyproject.toml, README.md, LICENSE.md and src/. Everything
# else only makes the context bigger and the layer cache less useful.

.git/
.github/
.venv/
venv/

__pycache__/
*.py[cod]
.mypy_cache/
.pytest_cache/
.ruff_cache/

dist/
build/
*.egg-info/

tests/
docs/
site/
deploy/
assets/
recordings/

.coverage
coverage.xml
htmlcov/

Dockerfile
docker-compose.yml
Makefile
*.md
!README.md
# hatchling's license-files points at this one, so the wheel build needs it in
# the context even though nothing at runtime reads it.
!LICENSE.md
